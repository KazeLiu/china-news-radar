# Copy to .env on the deployment server, then fill locally. Never commit real credentials.
RADAR_DOMAIN=china-news.951211.xyz
RADAR_USER=reader
# bcrypt hash from: docker run -it --rm caddy:2.10.2-alpine caddy hash-password
# Surround the hash with single quotes in .env so dollar signs remain literal.
RADAR_PASSWORD_HASH=
AI_ANALYSIS_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=100
TELEGRAM_ENABLED=false
TG_USE_CONFIRMED=false
TG_API_ID=
TG_API_HASH=
COLLECTOR_TOKEN=
# At least 32 characters; required for remote access to admin APIs.
ADMIN_TOKEN=
