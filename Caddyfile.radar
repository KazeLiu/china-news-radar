{$RADAR_DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$RADAR_USER} {$RADAR_PASSWORD_HASH}
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
	# The Telegram token endpoint is reachable only inside the Docker network.
	@ingest path /api/news/telegram /api/news/telegram/*
	handle @ingest {
		respond 404
	}
	@backend path /api/* /socket.io/* /aihot-skill
	handle @backend {
		reverse_proxy server:3001
	}
	# Next.js serves the upstream pages; management uses the application session.
	handle {
		reverse_proxy client:3000
	}
}
