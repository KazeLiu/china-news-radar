FROM node:22-bookworm-slim AS builder
RUN npm install -g pnpm@9.12.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/package.json
COPY client-next/package.json ./client-next/package.json
COPY rsshub-service/package.json ./rsshub-service/package.json
COPY telegram-collector/package.json ./telegram-collector/package.json
RUN pnpm install --filter client-next --frozen-lockfile
COPY client-next ./client-next
ARG INTERNAL_API_URL=http://server:3001
ENV INTERNAL_API_URL=$INTERNAL_API_URL NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter client-next build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/client-next/.next/standalone ./
COPY --from=builder --chown=node:node /app/client-next/.next/static ./client-next/.next/static
COPY --from=builder --chown=node:node /app/client-next/public ./client-next/public
USER node
EXPOSE 3000
CMD ["node", "client-next/server.js"]
