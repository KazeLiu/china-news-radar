FROM node:22.22.2-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@9.12.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY rsshub-service/package.json ./rsshub-service/package.json
COPY server/package.json ./server/package.json
COPY client-next/package.json ./client-next/package.json
ENV PUPPETEER_SKIP_DOWNLOAD=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pnpm install --filter radar-rsshub --prod --frozen-lockfile
COPY rsshub-service ./rsshub-service
ENV NODE_ENV=production RSSHUB_HOST=0.0.0.0 RSSHUB_PORT=3412
USER node
CMD ["node", "rsshub-service/main.mjs"]
