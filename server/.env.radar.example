DATABASE_URL=file:./radar.db
RADAR_MODE=news
HOST=127.0.0.1
PORT=3001
CLIENT_URL=http://localhost:3000
AI_ANALYSIS_ENABLED=true
# Without a key, rules remain the fallback. Configure secrets only on your own host.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=100
TELEGRAM_ENABLED=false
COLLECTOR_TOKEN=
# Localhost admin is available without a token. Remote admin requires at least 32 characters.
ADMIN_TOKEN=
# Only if the development machine needs an HTTP/HTTPS proxy:
RSS_PROXY_URL=
RSSHUB_BASE_URL=http://127.0.0.1:3412
