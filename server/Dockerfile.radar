FROM node:22-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@9.12.1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/package.json
COPY client-next/package.json ./client-next/package.json
COPY rsshub-service/package.json ./rsshub-service/package.json
RUN pnpm install --filter ai-hot-radar-server --frozen-lockfile
COPY server ./server
COPY scripts/init-db.cjs ./scripts/init-db.cjs
COPY scripts/admin-account.cjs ./scripts/admin-account.cjs
COPY scripts/install-camoufox.cjs ./scripts/install-camoufox.cjs
ENV DATABASE_URL=file:/data/radar.db
RUN pnpm --filter ai-hot-radar-server exec prisma generate && pnpm --filter ai-hot-radar-server build

FROM node:22-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates fonts-noto-cjk libgtk-3-0 libdbus-glib-1-2 libasound2 libx11-xcb1 libxt6 libxtst6 libnss3 libgbm1 libgl1 libpci3 && rm -rf /var/lib/apt/lists/* && npm install -g pnpm@9.12.1 && mkdir /data && chown node:node /data
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/prisma ./server/prisma
COPY --from=builder /app/server/prisma.config.ts ./server/prisma.config.ts
COPY --from=builder /app/server/package.json ./server/package.json
COPY --from=builder /app/scripts ./scripts
ENV NODE_ENV=production RADAR_MODE=news HOST=0.0.0.0 PORT=3001 DATABASE_URL=file:/data/radar.db
USER node
RUN node scripts/install-camoufox.cjs
EXPOSE 3001
CMD ["sh", "-c", "node scripts/init-db.cjs && node server/dist/main.js"]
