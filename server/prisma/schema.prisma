// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Keyword {
  id         String      @id @default(uuid())
  text       String      @unique
  category   String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  hotspots   Hotspot[]
  entityCard EntityCard?
  newsMatches NewsKeywordMatch[]
  newsProfile NewsEntityProfile?
}

model EntityCard {
  id          String   @id @default(uuid())
  keywordId   String   @unique
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  name        String
  type        String?  // model|company|product|technology|person
  summary     String?
  relatedData String?  // JSON: {relatedCompanies, relatedModels, relatedProducts, competesWith, aliases, tags}
  lastRefresh DateTime @default(now())
  createdAt   DateTime @default(now())
}

model EntityRelation {
  id       String @id @default(uuid())
  fromName String
  toName   String
  relation String // made_by|integrates|competes|related_to
  @@unique([fromName, toName])
}

model Hotspot {
  id              String    @id @default(uuid())
  newsItemId      String?   @unique
  newsItem        NewsItem? @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  notifyEligible Boolean @default(false)
  title           String
  content         String
  url             String
  source          String    // twitter, bing, google
  sourceId        String?   // 原始推文ID等
  isReal          Boolean   @default(true)
  relevance       Int       @default(0)
  relevanceReason String?   // AI 分析相关性的理由
  keywordMentioned Boolean?  // 内容中是否直接提及了关键词
  importance      String    @default("low")
  summary         String?
  viewCount       Int?
  likeCount       Int?
  retweetCount    Int?
  replyCount      Int?      // 回复数
  commentCount    Int?      // 评论数
  quoteCount      Int?      // 引用/转引数
  danmakuCount    Int?      // 弹幕数 (Bilibili)
  authorName      String?   // 作者名称
  authorUsername  String?   // 作者用户名
  authorAvatar    String?   // 作者头像
  authorFollowers Int?      // 作者粉丝数
  authorVerified  Boolean?  // 作者是否认证
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  keywordId       String?
  keyword         Keyword?  @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  category       String?   // model|product|industry|research|community|tips
  region         String?   // domestic|international
  sourceTier     String?   // T1|T1.5|T2
  qualityScore   Float?    // 0-100 composite quality score (code-computed)
  isCurated      Boolean   @default(false)
  tags           String?   // JSON array string e.g. ["tag1","tag2"]
  clusterKey     String?   // event clustering key (title hash)
  isClusterMain  Boolean   @default(true)
  biliCategory   String?   // Bilibili category name
  biliTags       String?   // Bilibili tags (comma-separated)
  favoritesCount Int?      // Bilibili favorites count
  media          String?   // JSON array of {type:'photo'|'video', url, previewUrl?}

  @@unique([url, source])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // hotspot, alert
  title     String
  content   String
  isRead    Boolean  @default(false)
  hotspotId String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // user | assistant
  content   String
  createdAt DateTime    @default(now())
}

model DailyDigest {
  id        String   @id @default(uuid())
  date      String   @unique  // YYYY-MM-DD (Beijing time)
  data      String   // JSON string with categorized digest
  createdAt DateTime @default(now())
}

model NewsSource {
  id             String    @id
  enabled        Boolean   @default(true)
  lastCheckedAt  DateTime?
  lastSuccessAt  DateTime?
  nextCheckAt    DateTime?
  error          String?
  etag           String?
  lastModified   String?
  lastItemCount  Int       @default(0)
  preferRsshub   Boolean   @default(false)
  activeKind     String?
  activeFeedUrl  String?
  feedFailures   String    @default("{}")
  rsshubError    String?
  rsshubRetryAt  DateTime?
  items          NewsItem[]
}

model NewsItem {
  id                 String     @id @default(uuid())
  sourceId           String
  source             NewsSource @relation(fields: [sourceId], references: [id])
  title              String
  titleZh            String?
  summary            String
  summaryZh          String?
  url                String
  originalPublisher  String?
  originalUrl        String?
  author             String?
  topic              String
  eventKey           String
  contentHash        String
  publishedAt        DateTime?
  firstSeenAt        DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  saved              Boolean    @default(false)
  visible            Boolean    @default(true)
  aiStatus           String     @default("disabled")
  analysisKey        String?
  decisionBy         String     @default("rules")
  aiRelation         String?
  aiTopics           String     @default("[]")
  aiType             String?
  aiLanguage         String?
  aiReason           String?
  aiInputTruncated   Boolean    @default(false)
  analyzedAt         DateTime?
  hotspot            Hotspot?
  keywordMatches     NewsKeywordMatch[]

  @@unique([sourceId, url])
  @@index([publishedAt, firstSeenAt])
  @@index([eventKey])
  @@index([topic, sourceId])
  @@index([analysisKey])
}

model NewsAnalysis {
  key         String   @id
  inputJson   String
  resultJson  String?
  status      String   @default("pending")
  attempts    Int      @default(0)
  retryAt     DateTime?
  leaseUntil  DateTime?
  model       String?
  error       String?
  analyzedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  historical Boolean @default(true)
  queuedTaskId String?

  @@index([status, retryAt])
}

model NewsKeywordMatch {
  newsItemId String
  keywordId String
  newsItem NewsItem @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  @@id([newsItemId, keywordId])
  @@index([keywordId])
}

model NewsDigest {
  date String @id
  data String
  createdAt DateTime @default(now())
}

model NewsEntityProfile {
  keywordId String @id
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  data String
  generatedAt DateTime @default(now())
}

model NewsGenerationLease {
  key String @id
  owner String
  leaseUntil DateTime
}

model AdminAccount {
  id String @id @default("admin")
  username String @unique
  passwordHash String
  updatedAt DateTime @updatedAt
}

model AdminSession {
  tokenHash String @id
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key String @id
  failures Int @default(0)
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
}

model AiTask {
  id String @id @default(uuid())
  kind String
  payload String
  activeKey String? @unique
  status String @default("queued")
  attempts Int @default(0)
  maxAttempts Int @default(3)
  availableAt DateTime @default(now())
  owner String?
  leaseUntil DateTime?
  resultJson String?
  errorJson String?
  failureHandled Boolean @default(false)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  requests AiRequest[]
  @@index([status, availableAt])
}

model AiRequest {
  id String @id @default(uuid())
  taskId String
  task AiTask @relation(fields: [taskId], references: [id])
  kind String
  model String
  attempt Int
  status String @default("running")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  elapsedMs Int?
  requestId String?
  errorJson String?
  analyzedCount Int @default(0)
  translatedCount Int @default(0)
  @@index([startedAt])
}
